<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pl.edu.pwr.simulation.tennispropath.controller.ConfigController"
      style="-fx-background-color: #121212; -fx-padding: 40;">

    <Label text="Konfiguracja Symulacji" textFill="#a3e635">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>

    <VBox spacing="8.0" alignment="CENTER_LEFT" style="-fx-min-width: 250;">
        <Label text="Imię i nazwisko tenisisty:" textFill="LIGHTGRAY" />
        <TextField fx:id="nameInputField" text="Roger Federer"
                   style="-fx-background-color: #1e1e1e; -fx-text-fill: white; -fx-padding: 8; -fx-border-color: #3b82f6; -fx-border-radius: 5; -fx-background-radius: 5;"/>
    </VBox>

    <Button text="ZATWIERDŹ I URUCHOM" onAction="#onStartSimulation"
            style="-fx-background-color: #a3e635; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 15 25; -fx-cursor: hand;"/>
</VBox>